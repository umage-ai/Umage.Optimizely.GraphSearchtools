<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>800e0205-cec7-4a2b-9c5d-249a12b7a589</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="EPiServer" />
    <Using Include="EPiServer.Core" />
    <Using Include="EPiServer.DataAbstraction" />
    <Using Include="EPiServer.DataAnnotations" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="EPiServer.CMS" Version="13.*" />
    <PackageReference Include="EPiServer.Cms.UI.AspNetIdentity" Version="13.*" />
    <PackageReference Include="Wangkanai.Detection" Version="8.7.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Translations\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Queries\AlloySearch.graphql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GraphSearchtools\GraphSearchtools.csproj" />
  </ItemGroup>

  <!-- Copy module files from the addon project during build (dev only, NuGet handles this via .targets) -->
  <Target Name="CopyGraphSearchtoolsModuleFiles" BeforeTargets="Build">
    <ItemGroup>
      <GraphSearchtoolsModuleFiles Include="..\GraphSearchtools\modules\_protected\GraphSearchtools\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(GraphSearchtoolsModuleFiles)" DestinationFiles="@(GraphSearchtoolsModuleFiles-&gt;'$(MSBuildProjectDirectory)\modules\_protected\GraphSearchtools\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
