    <!--
      Optimizely looks up friendly names for PermissionTypes under this path.
      /admin/permissiontype/groups/{Category}/description             -> category heading
      /admin/permissiontype/groups/{Category}/permissions/{Name}      -> permission description
      Element names MUST match the PermissionType(category, name) args in GraphSearchtoolsPermissions.cs.
    -->
    <admin>
      <permissiontype>
        <groups>
          <GraphSearchtools>
            <description>Graph Search Tools</description>
            <permissions>
              <Overview>Access the Graph Search Tools overview dashboard.</Overview>
              <Pinned>Manage pinned search results in Optimizely Graph.</Pinned>
              <Synonyms>Manage synonym rules in Optimizely Graph.</Synonyms>
              <Connectivity>Run Optimizely Graph connectivity diagnostics.</Connectivity>
              <Autocomplete>Test Optimizely Graph autocomplete suggestions.</Autocomplete>
              <SearchConsole>Run interactive Optimizely Graph queries.</SearchConsole>
              <SavedQueries>Manage saved Optimizely Graph query presets.</SavedQueries>
            </permissions>
          </GraphSearchtools>
        </groups>
      </permissiontype>
    </admin>
    <graphsearchtools>
      <menu>
        <title>Graph Search Tools</title>
        <overview>Overview</overview>
        <pinned>Pinned Results</pinned>
        <synonyms>Synonyms</synonyms>
        <connectivity>Connectivity</connectivity>
        <autocomplete>Autocomplete</autocomplete>
        <searchconsole>Search Console</searchconsole>
        <savedqueries>Saved Queries</savedqueries>
        <about>About</about>
      </menu>

      <tools>
        <overview>
          <title>Overview</title>
          <description>Dashboard of all Graph Search Tools.</description>
        </overview>
        <pinned>
          <title>Pinned Results</title>
          <description>Pin specific content to appear at the top of the search results for chosen phrases, per site and language.</description>
          <filter_placeholder>Filter by phrase or content...</filter_placeholder>
          <all_sites>All sites</all_sites>
          <add>Add</add>
          <col_site>Site</col_site>
          <col_phrase>Phrase</col_phrase>
          <col_content>Content</col_content>
        </pinned>
        <synonyms>
          <title>Synonyms</title>
          <description>Manage replacement and equivalent synonym rules per language. Editors can change behaviour without re-indexing.</description>
          <filter_placeholder>Filter rules...</filter_placeholder>
          <add>Add</add>
          <col_rule>Rule</col_rule>
          <save>Save changes</save>
          <help_replacement_label>Replacement</help_replacement_label>
          <help_replacement_text>searching "H2O" also returns results for "water", but not the reverse.</help_replacement_text>
          <help_equivalent_label>Equivalent</help_equivalent_label>
          <help_equivalent_text>searching any of these terms returns results for all three.</help_equivalent_text>
        </synonyms>
        <connectivity>
          <title>Connectivity Tester</title>
          <description>Verify the Optimizely Graph connection: gateway reachability, AppKey/Secret validity, query endpoint, and index population.</description>
          <probing>Probing…</probing>
          <refresh>Refresh</refresh>
          <col_status>Status</col_status>
          <col_probe>Probe</col_probe>
          <col_message>Detail</col_message>
        </connectivity>
        <autocomplete>
          <title>Autocomplete Tester</title>
          <description>Try out the Optimizely Graph autocomplete field. Pick a content type and a field — the dropdowns are populated by introspecting the live Graph schema, so what you see is what's actually queryable on this tenant.</description>
          <placeholder>Type to see suggestions…</placeholder>
          <type>Type</type>
          <type_placeholder>Search content types…</type_placeholder>
          <field>Field</field>
          <field_placeholder>Search fields…</field_placeholder>
          <locale_label>Locale</locale_label>
          <limit>Limit</limit>
        </autocomplete>
        <searchconsole>
          <title>Search Console</title>
          <description>Run interactive Graph queries with ranking knobs (RELEVANCE/SEMANTIC/BOOST_ONLY/DOC, semantic weight, minimum score). The exact GraphQL document is exposed for copy-paste.</description>
          <placeholder>Search phrase…</placeholder>
          <run>Run</run>
          <ranking>Ranking</ranking>
          <semantic_weight>Semantic weight</semantic_weight>
          <min_score>Minimum score</min_score>
          <limit>Limit</limit>
          <idle>Enter a query to run.</idle>
          <show_query>Show query</show_query>
          <col_name>Name</col_name>
          <col_type>Type</col_type>
          <col_lang>Lang</col_lang>
          <col_score>Score</col_score>
          <col_snippet>Snippet</col_snippet>
        </searchconsole>
        <savedqueries>
          <title>Saved Queries</title>
          <description>Save Search Console presets — phrase plus ranking knobs — and re-run them with one click. Stored locally per CMS install.</description>
          <empty_message>No saved queries yet. Save Search Console presets so you and other editors can re-run them with one click.</empty_message>
          <empty_cta>Create your first saved query</empty_cta>
          <filter_placeholder>Filter saved queries…</filter_placeholder>
          <add>New</add>
          <col_name>Name</col_name>
          <col_query>Query</col_query>
          <col_ranking>Ranking</col_ranking>
          <col_locale>Locale</col_locale>
          <new_title>New saved query</new_title>
          <edit_title>Edit saved query</edit_title>
          <field_name>Name</field_name>
          <field_description>Description</field_description>
          <field_query>Query</field_query>
          <field_locale>Locale</field_locale>
          <field_ranking>Ranking</field_ranking>
          <field_weight>Semantic weight</field_weight>
          <field_min_score>Minimum score</field_min_score>
          <field_limit>Limit</field_limit>
        </savedqueries>
      </tools>

