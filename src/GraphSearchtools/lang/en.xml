    <!--
      Optimizely looks up friendly names for PermissionTypes under this path.
      /admin/permissiontype/groups/{Category}/description             -> category heading
      /admin/permissiontype/groups/{Category}/permissions/{Name}      -> permission description
      Element names MUST match the PermissionType(category, name) args in GraphSearchtoolsPermissions.cs.
    -->
    <admin>
      <permissiontype>
        <groups>
          <GraphSearchtools>
            <description>Graph Search Tools</description>
            <permissions>
              <Overview>Access the Graph Search Tools overview dashboard.</Overview>
              <Pinned>Manage pinned search results in Optimizely Graph.</Pinned>
              <Synonyms>Manage synonym rules in Optimizely Graph.</Synonyms>
              <Health>Run Optimizely Graph health probes — gateway, credentials, query endpoint, index population.</Health>
              <Autocomplete>Test Optimizely Graph autocomplete suggestions.</Autocomplete>
              <Profiles>Manage Search Profiles — pinned results, synonyms, ranking per registered search surface.</Profiles>
              <DecaySandbox>Visualize Gaussian decay and factor modifier curves; emit GraphQL fragments.</DecaySandbox>
              <SemanticTuner>Edit the token-count-tiered Semantic Weight policy and emit the matching appsettings.json snippet.</SemanticTuner>
              <Webhooks>Manage Optimizely Graph webhooks — list, create, delete.</Webhooks>
              <CustomDataSources>Inspect non-CMS data sources registered with Optimizely Graph and trigger a full resync per source.</CustomDataSources>
              <RequestLogs>View recent Optimizely Graph queries with timing, ranking and result count; replay one in Search Console.</RequestLogs>
              <Telemetry>Push search-log telemetry from host search surfaces.</Telemetry>
            </permissions>
          </GraphSearchtools>
        </groups>
      </permissiontype>
    </admin>
