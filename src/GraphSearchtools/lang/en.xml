<?xml version="1.0" encoding="utf-8"?>
<languages>
  <language name="English" id="en">
    <!--
      Optimizely looks up friendly names for PermissionTypes under this path.
      /admin/permissiontype/groups/{Category}/description             -> category heading
      /admin/permissiontype/groups/{Category}/permissions/{Name}      -> permission description
      Element names MUST match the PermissionType(category, name) args in GraphSearchtoolsPermissions.cs.
    -->
    <admin>
      <permissiontype>
        <groups>
          <GraphSearchtools>
            <description>Graph Search Tools</description>
            <permissions>
              <Overview>Access the Graph Search Tools overview dashboard.</Overview>
              <Pinned>Manage pinned search results in Optimizely Graph.</Pinned>
              <Synonyms>Manage synonym rules in Optimizely Graph.</Synonyms>
            </permissions>
          </GraphSearchtools>
        </groups>
      </permissiontype>
    </admin>
    <graphsearchtools>
      <menu>
        <title>Graph Search Tools</title>
        <overview>Overview</overview>
        <pinned>Pinned Results</pinned>
        <synonyms>Synonyms</synonyms>
        <about>About</about>
      </menu>

      <tools>
        <overview>
          <title>Overview</title>
          <description>Dashboard of all Graph Search Tools.</description>
        </overview>
        <pinned>
          <title>Pinned Results</title>
          <description>Pin specific content to appear at the top of the search results for chosen phrases, per site and language.</description>
          <filter_placeholder>Filter by phrase or content...</filter_placeholder>
          <all_sites>All sites</all_sites>
          <add>Add</add>
          <col_site>Site</col_site>
          <col_phrase>Phrase</col_phrase>
          <col_content>Content</col_content>
        </pinned>
        <synonyms>
          <title>Synonyms</title>
          <description>Manage replacement and equivalent synonym rules per language. Editors can change behaviour without re-indexing.</description>
          <filter_placeholder>Filter rules...</filter_placeholder>
          <add>Add</add>
          <col_rule>Rule</col_rule>
          <save>Save changes</save>
          <help_replacement_label>Replacement</help_replacement_label>
          <help_replacement_text>searching "H2O" also returns results for "water", but not the reverse.</help_replacement_text>
          <help_equivalent_label>Equivalent</help_equivalent_label>
          <help_equivalent_text>searching any of these terms returns results for all three.</help_equivalent_text>
        </synonyms>
      </tools>

      <about>
        <title>About Graph Search Tools</title>
        <description>Editor and admin tooling for Optimizely Graph: pinned results, synonyms, query playground, and relevancy tuning.</description>
        <version>Version</version>
        <repository>Repository</repository>
        <license>License</license>
        <poweredby>Powered by umage.ai</poweredby>
      </about>

      <ui>
        <shared>
          <loading>Loading...</loading>
          <noresults>No results.</noresults>
          <cancel>Cancel</cancel>
          <apply>Apply</apply>
          <close>Close</close>
          <refresh>Refresh</refresh>
          <save>Save</save>
          <delete>Delete</delete>
          <edit>Edit</edit>
          <failed>Failed</failed>
          <yes>Yes</yes>
          <no>No</no>
          <open>Open</open>
          <all>All</all>
          <prev>Previous</prev>
          <next>Next</next>
        </shared>
        <components>
          <picker_title>Select content</picker_title>
          <picker_search>Search content...</picker_search>
          <picker_noresults>No content matches your search.</picker_noresults>
          <btn_cancel>Cancel</btn_cancel>
          <btn_select>Select</btn_select>
          <typepicker_title>Select content type</typepicker_title>
          <typepicker_search>Search content types...</typepicker_search>
          <typepicker_noresults>No content type matches your search.</typepicker_noresults>
        </components>
        <graphsearchtools>
          <loading>Loading...</loading>
          <noresults>No results.</noresults>
        </graphsearchtools>
        <pinned>
          <request_failed>Request failed</request_failed>
          <all_sites>All sites</all_sites>
          <action_save>Save</action_save>
          <action_delete>Delete</action_delete>
