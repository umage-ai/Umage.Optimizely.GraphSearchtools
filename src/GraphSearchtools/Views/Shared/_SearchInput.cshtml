@*
    Aurora search input — magnifying-glass icon + text input wrapped in
    .gst-search. See design-system.md → Component: Toolbar. Seven copies
    of this markup existed before P2.1; this is the single source.

    Usage:
        @await Html.PartialAsync("/Views/Shared/_SearchInput.cshtml",
            new { Id = "gst-pin-search", Placeholder = Loc.GetString("…") })
*@
@model dynamic
@{
    string id = (string)(Model?.Id ?? "");
    string placeholder = (string)(Model?.Placeholder ?? "");
}
<div class="gst-search">
    @await Html.PartialAsync("/Views/Shared/_Icon.cshtml", new { Name = "search", Size = 16, Class = "gst-search__icon" })
    <input type="text" id="@id" placeholder="@placeholder" />
</div>
