@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/indexInspector/title");
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/tools/indexInspector/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/tools/indexInspector/description")</p>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

<div class="gst-card">
    <div class="gst-toolbar">
        <div class="gst-toolbar__spacer"></div>
        <button type="button" id="ii-refresh" class="gst-btn">@Loc.GetString("/graphsearchtools/tools/indexInspector/refresh")</button>
    </div>

    @* ─── Top stats row ─── *@
    <div class="gst-stats-row">
        <div class="gst-stat">
            <div class="gst-stat__label">@Loc.GetString("/graphsearchtools/tools/indexInspector/total_items")</div>
            <div class="gst-stat__value" id="ii-total">—</div>
        </div>
        <div class="gst-stat">
            <div class="gst-stat__label">@Loc.GetString("/graphsearchtools/tools/indexInspector/content_types")</div>
            <div class="gst-stat__value" id="ii-types">—</div>
        </div>
        <div class="gst-stat">
            <div class="gst-stat__label">@Loc.GetString("/graphsearchtools/tools/indexInspector/missing_name")</div>
            <div class="gst-stat__value" id="ii-missing-name">—</div>
        </div>
        <div class="gst-stat">
            <div class="gst-stat__label">@Loc.GetString("/graphsearchtools/tools/indexInspector/captured_at")</div>
            <div class="gst-stat__value" id="ii-captured">—</div>
        </div>
    </div>

    <table class="gst-table">
        <thead>
            <tr>
                <th>@Loc.GetString("/graphsearchtools/tools/indexInspector/col_type")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/indexInspector/col_count")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/indexInspector/col_missing_name")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/indexInspector/col_missing_teaser")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/indexInspector/col_missing_body")</th>
            </tr>
        </thead>
        <tbody id="ii-grid"></tbody>
    </table>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/index-inspector.js")"></script>
}
