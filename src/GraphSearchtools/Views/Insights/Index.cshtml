@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/insights/title");
    string T(string key) => Loc.GetString($"/graphsearchtools/tools/insights/{key}");
}

<div class="gst-page-header">
    <h1>@T("title")</h1>
    <p>@T("description")</p>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

@* 30d KPI strip — three headline numbers (total searches, daily CTR,
   zero-result searches) each with a 30-day sparkline. Window is fixed
   at 30d regardless of the page-level Window selector (which scopes the
   lane tables); the sparkline needs 30 buckets to be useful. Sparkline
   click filters the active tab to one day. *@
<div class="gst-card gst-sl-card gst-sl-card--wide" data-card="kpis">
    <div id="gst-insights-kpis" class="gst-kpis" aria-live="polite">
        @* JS renders three .gst-kpi tiles with sparklines. *@
    </div>
</div>

@* Tab strip — one tab per lane (Top / Zero-result / Low-CTR). The toolbar
   below scopes whichever tab is visible; filter state carries across tabs
   so switching doesn't reset what the user picked. Channel is the one
   filter that also bleeds upward to re-scope the KPI card. *@
<div class="gst-card">
    <div class="gst-tabs" role="tablist" aria-label="@T("title")">
        <button type="button" class="gst-tab active" role="tab"
                id="gst-ins-tab-top" data-tab="top"
                aria-selected="true" aria-controls="gst-ins-panel-top">@T("tab_top")<span class="gst-tab__count" id="gst-ins-top-count" hidden></span></button>
        <button type="button" class="gst-tab" role="tab"
                id="gst-ins-tab-zero" data-tab="zero"
                aria-selected="false" aria-controls="gst-ins-panel-zero">@T("tab_zero")<span class="gst-tab__count" id="gst-ins-zero-count" hidden></span></button>
        <button type="button" class="gst-tab" role="tab"
                id="gst-ins-tab-lowctr" data-tab="lowctr"
                aria-selected="false" aria-controls="gst-ins-panel-lowctr">@T("tab_lowctr")<span class="gst-tab__count" id="gst-ins-lowctr-count" hidden></span></button>
    </div>

    <div class="gst-toolbar gst-sl-toolbar">
        <div class="gst-search">
            <svg class="gst-search__icon" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="gst-insights-phrase-filter"
                   placeholder="@T("phrase_filter_placeholder")" />
        </div>
        <label class="gst-filter">
            <span class="gst-filter__label">@T("col_channel")</span>
            <select class="gst-filter__select" id="gst-insights-channel-filter">
                <option value="">@T("channel_filter_all")</option>
            </select>
        </label>
        <label class="gst-filter">
            <span class="gst-filter__label">@T("col_locale")</span>
            <select class="gst-filter__select" id="gst-insights-locale-filter">
                <option value="">@T("locale_filter_all")</option>
            </select>
        </label>
        <label class="gst-filter">
            <span class="gst-filter__label">@T("window_filter_label")</span>
            <select class="gst-filter__select" id="gst-insights-window-filter">
                <option value="7">@T("window_7d")</option>
                <option value="30">@T("window_30d")</option>
            </select>
        </label>
        <div class="gst-toolbar__spacer"></div>
    </div>

    <div class="gst-ins-panels">
        @* Top — most-asked phrases. Aurora-style read-only telemetry table:
           no row-click, no flyout, no ⋯ menu (per design-system.md:139). *@
        <section class="gst-ins-tabpanel is-active" data-lane="top"
                 id="gst-ins-panel-top" role="tabpanel" aria-labelledby="gst-ins-tab-top">
            <table class="gst-table gst-ins-aurora-table" data-lane="top">
                <thead>
                    <tr>
                        <th data-sort="phrase">@T("col_phrase")</th>
                        <th data-sort="channel">@T("col_channel")</th>
                        <th data-sort="locale">@T("col_locale")</th>
                        <th data-sort="hits" class="num">@T("col_hits")</th>
                        <th data-sort="zero" class="num">@T("col_zero_count")</th>
                    </tr>
                </thead>
                <tbody id="gst-ins-top"></tbody>
            </table>
        </section>

        @* Zero-result — synonym-mining surface. *@
        <section class="gst-ins-tabpanel" data-lane="zero"
                 id="gst-ins-panel-zero" role="tabpanel" aria-labelledby="gst-ins-tab-zero">
            <table class="gst-table gst-ins-aurora-table" data-lane="zero">
                <thead>
                    <tr>
                        <th data-sort="phrase">@T("col_phrase")</th>
                        <th data-sort="channel">@T("col_channel")</th>
                        <th data-sort="locale">@T("col_locale")</th>
                        <th data-sort="hits" class="num">@T("col_hits")</th>
                    </tr>
                </thead>
                <tbody id="gst-ins-zero"></tbody>
            </table>
        </section>

        @* Low-CTR — pin-candidate surface. *@
        <section class="gst-ins-tabpanel" data-lane="lowctr"
                 id="gst-ins-panel-lowctr" role="tabpanel" aria-labelledby="gst-ins-tab-lowctr">
            <table class="gst-table gst-ins-aurora-table" data-lane="lowctr">
                <thead>
                    <tr>
                        <th data-sort="phrase">@T("col_phrase")</th>
                        <th data-sort="channel">@T("col_channel")</th>
                        <th data-sort="locale">@T("col_locale")</th>
                        <th data-sort="hits" class="num">@T("col_hits")</th>
                        <th data-sort="ctr" class="num">@T("col_ctr")</th>
                    </tr>
                </thead>
                <tbody id="gst-ins-lowctr"></tbody>
            </table>
        </section>
    </div>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/insights.js")"></script>
}
