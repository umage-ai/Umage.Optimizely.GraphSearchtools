@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/insights/title");
    string T(string key) => Loc.GetString($"/graphsearchtools/tools/insights/{key}");
    string Sh(string key) => Loc.GetString($"/graphsearchtools/ui/shared/{key}");
}

<div class="gst-page-header">
    <h1>@T("title")</h1>
    <p>@T("description")</p>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

@* Toolbar: window pill (7d/30d), profile filter pill (All + per-profile,
   populated by JS from /api/profiles), refresh. *@
<div class="gst-card gst-sl-toolbar-card">
    <div class="gst-toolbar gst-sl-toolbar">
        <div class="gst-sl-pillgroup" role="group" aria-label="@T("title")">
            <button type="button" class="gst-sl-pill gst-sl-pill--active" data-days="7">@T("window_7d")</button>
            <button type="button" class="gst-sl-pill" data-days="30">@T("window_30d")</button>
        </div>
        <div class="gst-sl-pillgroup gst-ins-profilefilter" id="gst-insights-profilefilter"
             role="group" aria-label="@T("profile_filter_label")">
            <button type="button" class="gst-sl-pill gst-sl-pill--active" data-profile="">@T("profile_filter_all")</button>
        </div>
        <div class="gst-toolbar__spacer"></div>
        <button type="button" id="gst-insights-refresh" class="gst-btn">@Sh("refresh")</button>
    </div>
</div>

@* 30d KPI strip — three headline numbers (total searches, daily CTR,
   zero-result searches) each with a 30-day sparkline. Window is fixed
   at 30d regardless of the page-level 7/30 pill (which scopes the lane
   tables); the sparkline needs 30 buckets to be useful. Sparkline click
   filters the active tab to one day. *@
<div class="gst-card gst-sl-card gst-sl-card--wide" data-card="kpis">
    <div class="gst-sl-card__head">
        <h2>@T("kpis_title")</h2>
        <p class="gst-muted">@T("kpis_subtitle")</p>
    </div>
    <div id="gst-insights-kpis" class="gst-kpis" aria-live="polite">
        @* JS renders three .gst-kpi tiles with sparklines. *@
    </div>
</div>

@* Tab strip — one tab per lane (Top / Zero-result / Low-CTR). *@
<div class="gst-card">
    <div class="gst-tabs" role="tablist" aria-label="@T("title")">
        <button type="button" class="gst-tab active" role="tab"
                id="gst-ins-tab-top" data-tab="top"
                aria-selected="true" aria-controls="gst-ins-panel-top">@T("tab_top")</button>
        <button type="button" class="gst-tab" role="tab"
                id="gst-ins-tab-zero" data-tab="zero"
                aria-selected="false" aria-controls="gst-ins-panel-zero">@T("tab_zero")</button>
        <button type="button" class="gst-tab" role="tab"
                id="gst-ins-tab-lowctr" data-tab="lowctr"
                aria-selected="false" aria-controls="gst-ins-panel-lowctr">@T("tab_lowctr")</button>
    </div>

    <div class="gst-prof-ins gst-ins-panels">
        @* Top — most-asked phrases. *@
        <section class="gst-prof-ins-lane gst-prof-ins-lane--top gst-ins-tabpanel is-active" data-lane="top"
                 id="gst-ins-panel-top" role="tabpanel" aria-labelledby="gst-ins-tab-top">
            <header class="gst-prof-ins-lane__head">
                <span class="gst-prof-ins-lane__rule" aria-hidden="true"></span>
                <h2 class="gst-prof-ins-lane__title">@T("top_title")</h2>
                <span class="gst-prof-ins-lane__hint">@T("top_subtitle")</span>
                <span class="gst-prof-ins-lane__count" id="gst-ins-top-count">—</span>
            </header>
            <ol class="gst-prof-ins-lane__list" id="gst-ins-top"></ol>
        </section>

        @* Zero-result — synonym-mining surface. *@
        <section class="gst-prof-ins-lane gst-prof-ins-lane--zero gst-ins-tabpanel" data-lane="zero"
                 id="gst-ins-panel-zero" role="tabpanel" aria-labelledby="gst-ins-tab-zero">
            <header class="gst-prof-ins-lane__head">
                <span class="gst-prof-ins-lane__rule" aria-hidden="true"></span>
                <h2 class="gst-prof-ins-lane__title">@T("zero_title")</h2>
                <span class="gst-prof-ins-lane__hint">@T("zero_subtitle")</span>
                <span class="gst-prof-ins-lane__count" id="gst-ins-zero-count">—</span>
            </header>
            <ol class="gst-prof-ins-lane__list" id="gst-ins-zero"></ol>
        </section>

        @* Low-CTR — pin-candidate surface. *@
        <section class="gst-prof-ins-lane gst-prof-ins-lane--lowctr gst-ins-tabpanel" data-lane="lowctr"
                 id="gst-ins-panel-lowctr" role="tabpanel" aria-labelledby="gst-ins-tab-lowctr">
            <header class="gst-prof-ins-lane__head">
                <span class="gst-prof-ins-lane__rule" aria-hidden="true"></span>
                <h2 class="gst-prof-ins-lane__title">@T("lowctr_title")</h2>
                <span class="gst-prof-ins-lane__hint">@T("lowctr_subtitle")</span>
                <span class="gst-prof-ins-lane__count" id="gst-ins-lowctr-count">—</span>
            </header>
            <ol class="gst-prof-ins-lane__list" id="gst-ins-lowctr"></ol>
        </section>
    </div>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/insights.js")"></script>
}
