@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/customDataSources/title");
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/tools/customDataSources/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/tools/customDataSources/description")</p>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

<div class="gst-card">
    <table class="gst-table">
        <thead>
            <tr>
                <th>@Loc.GetString("/graphsearchtools/tools/customDataSources/col_name")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/customDataSources/col_type")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/customDataSources/col_items")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/customDataSources/col_lastSynced")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/customDataSources/col_status")</th>
                <th class="gst-cds-actions-col">@Loc.GetString("/graphsearchtools/tools/customDataSources/col_actions")</th>
            </tr>
        </thead>
        <tbody id="cds-grid"></tbody>
    </table>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/custom-data-sources.js")"></script>
}
