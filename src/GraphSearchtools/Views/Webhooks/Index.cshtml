@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/webhooks/title");
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/tools/webhooks/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/tools/webhooks/description")</p>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

<div class="gst-alert gst-alert--info">
    @Loc.GetString("/graphsearchtools/tools/webhooks/no_edit_notice")
</div>

<div class="gst-card">
    <div class="gst-toolbar">
        <div class="gst-toolbar__spacer"></div>
        <button type="button" id="wh-add" class="gst-btn gst-btn--primary">@Loc.GetString("/graphsearchtools/tools/webhooks/add")</button>
    </div>

    <table class="gst-table">
        <thead>
            <tr>
                <th>@Loc.GetString("/graphsearchtools/tools/webhooks/col_url")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/webhooks/col_method")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/webhooks/col_headers")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/webhooks/col_filters")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/webhooks/col_status")</th>
                <th>@Loc.GetString("/graphsearchtools/tools/webhooks/col_created")</th>
                <th class="gst-webhook-actions-col">@Loc.GetString("/graphsearchtools/tools/webhooks/col_actions")</th>
            </tr>
        </thead>
        <tbody id="wh-grid"></tbody>
    </table>
</div>

@* ───────── Create dialog ───────── *@
<div id="wh-dialog" class="gst-dialog-backdrop" hidden>
    <div class="gst-dialog">
        <div class="gst-dialog__header">
            <span class="gst-dialog__title">@Loc.GetString("/graphsearchtools/tools/webhooks/dialog_new")</span>
            <button type="button" id="wh-dialog-close" class="gst-dialog__close" aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
        </div>
        <div class="gst-dialog__body">
            <div class="gst-webhook-field">
                <label for="wh-dlg-url">@Loc.GetString("/graphsearchtools/tools/webhooks/field_url") *</label>
                <input id="wh-dlg-url" type="url" placeholder="@Loc.GetString("/graphsearchtools/tools/webhooks/field_url_placeholder")" />
            </div>
            <div class="gst-webhook-field">
                <label for="wh-dlg-method">@Loc.GetString("/graphsearchtools/tools/webhooks/field_method")</label>
                <select id="wh-dlg-method" class="gst-select">
                    <option value="POST">POST</option>
                    <option value="PUT">PUT</option>
                </select>
            </div>
            <div class="gst-webhook-field">
                <label>@Loc.GetString("/graphsearchtools/tools/webhooks/field_headers")</label>
                <div id="wh-dlg-headers" class="gst-webhook-kv"></div>
                <button type="button" id="wh-dlg-headers-add" class="gst-btn gst-btn--sm">+</button>
            </div>
            <div class="gst-webhook-field">
                <label>@Loc.GetString("/graphsearchtools/tools/webhooks/field_filters")</label>
                <div id="wh-dlg-filters" class="gst-webhook-kv"></div>
                <button type="button" id="wh-dlg-filters-add" class="gst-btn gst-btn--sm">+</button>
            </div>
        </div>
        <div class="gst-dialog__footer">
            <button type="button" id="wh-dialog-cancel" class="gst-btn">@Loc.GetString("/graphsearchtools/tools/webhooks/cancel")</button>
            <button type="button" id="wh-dialog-save" class="gst-btn gst-btn--primary">@Loc.GetString("/graphsearchtools/tools/webhooks/save")</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/webhooks.js")"></script>
}
