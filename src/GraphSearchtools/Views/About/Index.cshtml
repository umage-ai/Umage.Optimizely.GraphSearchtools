@using System.Reflection
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/about/title");

    var assembly = typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider).Assembly;
    var version = assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
                  ?? assembly.GetName().Version?.ToString()
                  ?? "unknown";
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/about/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/about/description")</p>
</div>

<div class="gst-about">
    <dl>
        <dt>@Loc.GetString("/graphsearchtools/about/version")</dt>
        <dd>@version</dd>
        <dt>@Loc.GetString("/graphsearchtools/about/repository")</dt>
        <dd><a href="https://github.com/umage-ai/Umage.Optimizely.GraphSearchtools" target="_blank" rel="noopener">github.com/umage-ai/Umage.Optimizely.GraphSearchtools</a></dd>
        <dt>@Loc.GetString("/graphsearchtools/about/license")</dt>
        <dd>MIT</dd>
    </dl>
</div>
