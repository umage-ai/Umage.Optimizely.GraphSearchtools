@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/channels/index/title");
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/channels/index/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/channels/index/subtitle")</p>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

@* ───────── Channel index card ───────── *@
<div class="gst-card">
    <div class="gst-toolbar">
        @await Html.PartialAsync("/Views/Shared/_SearchInput.cshtml",
            new { Id = "gst-prof-search", Placeholder = Loc.GetString("/graphsearchtools/channels/index/filterPlaceholder") })
        <label class="gst-filter">
            <span class="gst-filter__label">@Loc.GetString("/graphsearchtools/channels/index/filter/labelSite")</span>
            <select id="gst-prof-site-filter" class="gst-filter__select">
                <option value="">@Loc.GetString("/graphsearchtools/channels/index/filter/allSites")</option>
            </select>
        </label>
        <label class="gst-filter">
            <span class="gst-filter__label">@Loc.GetString("/graphsearchtools/channels/index/filter/labelLocale")</span>
            <select id="gst-prof-locale-filter" class="gst-filter__select">
                <option value="">@Loc.GetString("/graphsearchtools/channels/index/filter/allLocales")</option>
            </select>
        </label>
        <div class="gst-toolbar__spacer"></div>
        <span id="gst-prof-count" class="gst-muted">&nbsp;</span>
    </div>

    <div id="gst-prof-table-host"></div>

    <div id="gst-prof-empty" class="gst-empty" hidden>
        <h3>@Loc.GetString("/graphsearchtools/channels/index/empty/title")</h3>
        <p>@Loc.GetString("/graphsearchtools/channels/index/empty/body")</p>
    </div>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/channels.js")"></script>
    <script>
        (function() {
            if (window.GST && window.GST.channels && typeof window.GST.channels.index === 'function') {
                window.GST.channels.index({
                    detailUrlBase: '@Html.Raw(Paths.ToResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "Channels/Index"))?key='
                });
            }
        })();
    </script>
}
