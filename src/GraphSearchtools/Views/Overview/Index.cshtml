@using EPiServer.Shell
@inject LocalizationService Loc
@inject UmageAI.Optimizely.GraphSearchTools.Permissions.PermissionMap PermissionMap
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/overview/title");

    string Tile(string actionPath) => Paths.ToResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), actionPath);

    var perms = PermissionMap.ForCurrentUser();
    var noAccessTooltip = Loc.GetString("/graphsearchtools/tools/overview/noAccess");
}

@section NavItems {
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/menu/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/tools/overview/description")</p>
</div>

<div class="gst-tool-grid">
    @await Html.PartialAsync("/Views/Overview/_ToolCard.cshtml", new ViewDataDictionary(ViewData)
    {
        ["Allowed"] = perms.channels,
        ["Href"] = Tile("Channels/Index"),
        ["Icon"] = "channels",
        ["Title"] = Loc.GetString("/graphsearchtools/menu/channels"),
        ["Desc"] = Loc.GetString("/graphsearchtools/tools/channels/description"),
        ["NoAccessTooltip"] = noAccessTooltip
    })

    @await Html.PartialAsync("/Views/Overview/_ToolCard.cshtml", new ViewDataDictionary(ViewData)
    {
        ["Allowed"] = perms.insights,
        ["Href"] = Tile("Insights/Index"),
        ["Icon"] = "insights",
        ["Title"] = Loc.GetString("/graphsearchtools/menu/insights"),
        ["Desc"] = Loc.GetString("/graphsearchtools/tools/insights/description"),
        ["NoAccessTooltip"] = noAccessTooltip
    })

    @await Html.PartialAsync("/Views/Overview/_ToolCard.cshtml", new ViewDataDictionary(ViewData)
    {
        ["Allowed"] = perms.pinned,
        ["Href"] = Tile("GraphSearchtools/Pinned"),
        ["Icon"] = "pin",
        ["Title"] = Loc.GetString("/graphsearchtools/tools/pinned/title"),
        ["Desc"] = Loc.GetString("/graphsearchtools/tools/pinned/description"),
        ["NoAccessTooltip"] = noAccessTooltip
    })

    @await Html.PartialAsync("/Views/Overview/_ToolCard.cshtml", new ViewDataDictionary(ViewData)
    {
        ["Allowed"] = perms.synonyms,
        ["Href"] = Tile("GraphSearchtools/Synonyms"),
        ["Icon"] = "synonym",
        ["Title"] = Loc.GetString("/graphsearchtools/tools/synonyms/title"),
        ["Desc"] = Loc.GetString("/graphsearchtools/tools/synonyms/description"),
        ["NoAccessTooltip"] = noAccessTooltip
    })
</div>
