@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/overview/title");

    string Tile(string actionPath) => Paths.ToResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), actionPath);
}

@section NavItems {
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/menu/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/tools/overview/description")</p>
</div>

<div class="gst-tool-grid">
    <a class="gst-tool-card" href="@Tile("GraphSearchtools/Pinned")">
        <svg class="gst-tool-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v6m0 0l3.5 8.5L19 20l-7-2-7 2 3.5-3.5L12 8z"/>
        </svg>
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/tools/pinned/title")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/pinned/description")</div>
    </a>

    <a class="gst-tool-card" href="@Tile("GraphSearchtools/Synonyms")">
        <svg class="gst-tool-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 7h7M3 12h7M3 17h7"/>
            <path d="M14 7l7 5-7 5"/>
        </svg>
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/tools/synonyms/title")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/synonyms/description")</div>
    </a>

    <a class="gst-tool-card" href="@Tile("GraphSearchtools/Health")">
        <svg class="gst-tool-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12h4l2-7 4 14 2-7h6"/>
        </svg>
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/tools/health/title")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/health/description")</div>
    </a>

    <a class="gst-tool-card" href="@Tile("GraphSearchtools/Autocomplete")">
        <svg class="gst-tool-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h16M4 12h10M4 18h7"/>
            <path d="M18 14l4 4-4 4"/>
        </svg>
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/tools/autocomplete/title")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/autocomplete/description")</div>
    </a>

    <a class="gst-tool-card" href="@Tile("GraphSearchtools/DecaySandbox")">
        <svg class="gst-tool-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 20h18"/>
            <path d="M3 20c4-1 6-14 9-14s5 13 9 13"/>
        </svg>
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/tools/decaySandbox/title")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/decaySandbox/description")</div>
    </a>

    <a class="gst-tool-card" href="@Tile("GraphSearchtools/Webhooks")">
        <svg class="gst-tool-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7A3.5 3.5 0 0 0 9 12c0-.24-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81a3 3 0 1 0-3-3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9a3 3 0 0 0 0 6c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65a2.92 2.92 0 1 0 2.92-2.92z"/>
        </svg>
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/tools/webhooks/title")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/webhooks/description")</div>
    </a>

    <a class="gst-tool-card" href="@Tile("GraphSearchtools/CustomDataSources")">
        <svg class="gst-tool-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="8" ry="3"/>
            <path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/>
            <path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"/>
        </svg>
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/tools/customDataSources/title")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/customDataSources/description")</div>
    </a>

    <a class="gst-tool-card" href="@Tile("GraphSearchtools/RequestLogs")">
        <svg class="gst-tool-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h16M4 12h10M4 18h13"/>
            <circle cx="19" cy="6" r="1.2"/>
            <circle cx="17" cy="12" r="1.2"/>
        </svg>
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/tools/requestLogs/title")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/requestLogs/description")</div>
    </a>
</div>
