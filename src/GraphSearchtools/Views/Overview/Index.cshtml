@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/overview/title");

    string Tile(string actionPath) => Paths.ToResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), actionPath);
}

@section NavItems {
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/menu/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/tools/overview/description")</p>
</div>

<div class="gst-tool-grid">
    <a class="gst-tool-card" href="/EPiServer/cms/graphsearchtools/channels">
        @await Html.PartialAsync("/Views/Shared/_Icon.cshtml", new { Name = "channels", Size = 28, Class = "gst-tool-card__icon" })
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/menu/channels")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/channels/description")</div>
    </a>

    <a class="gst-tool-card" href="@Tile("Insights/Index")">
        @await Html.PartialAsync("/Views/Shared/_Icon.cshtml", new { Name = "insights", Size = 28, Class = "gst-tool-card__icon" })
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/menu/insights")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/insights/description")</div>
    </a>

    <a class="gst-tool-card" href="@Tile("GraphSearchtools/Pinned")">
        @await Html.PartialAsync("/Views/Shared/_Icon.cshtml", new { Name = "pin", Size = 28, Class = "gst-tool-card__icon" })
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/tools/pinned/title")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/pinned/description")</div>
    </a>

    <a class="gst-tool-card" href="@Tile("GraphSearchtools/Synonyms")">
        @await Html.PartialAsync("/Views/Shared/_Icon.cshtml", new { Name = "synonym", Size = 28, Class = "gst-tool-card__icon" })
        <div class="gst-tool-card__title">@Loc.GetString("/graphsearchtools/tools/synonyms/title")</div>
        <div class="gst-tool-card__desc">@Loc.GetString("/graphsearchtools/tools/synonyms/description")</div>
    </a>


</div>
