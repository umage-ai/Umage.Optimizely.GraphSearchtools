@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/searchconsole/title");
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/tools/searchconsole/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/tools/searchconsole/description")</p>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

<div class="gst-card gst-sc-controls">
    <div class="gst-toolbar">
        <input id="sc-query" type="text" class="gst-sc-query"
               placeholder="@Loc.GetString("/graphsearchtools/tools/searchconsole/placeholder")"
               autocomplete="off" />
        <select id="sc-locale" class="gst-select"></select>
        <button type="button" id="sc-run" class="gst-btn gst-btn--primary">@Loc.GetString("/graphsearchtools/tools/searchconsole/run")</button>
    </div>

    <div class="gst-sc-knobs">
        <label class="gst-sc-knob">
            <span>@Loc.GetString("/graphsearchtools/tools/searchconsole/ranking")</span>
            <select id="sc-ranking" class="gst-select">
                <option value="RELEVANCE">RELEVANCE</option>
                <option value="SEMANTIC">SEMANTIC</option>
                <option value="BOOST_ONLY">BOOST_ONLY</option>
                <option value="DOC">DOC</option>
            </select>
        </label>
        <label class="gst-sc-knob">
            <span>@Loc.GetString("/graphsearchtools/tools/searchconsole/semantic_weight") <output id="sc-weight-out">0.2</output></span>
            <input id="sc-weight" type="range" min="-1" max="1" step="0.05" value="0.2" />
        </label>
        <label class="gst-sc-knob">
            <span>@Loc.GetString("/graphsearchtools/tools/searchconsole/min_score")</span>
            <input id="sc-min-score" type="number" step="0.1" placeholder="—" />
        </label>
        <label class="gst-sc-knob">
            <span>@Loc.GetString("/graphsearchtools/tools/searchconsole/limit")</span>
            <input id="sc-limit" type="number" min="1" max="100" value="25" />
        </label>
    </div>
</div>

<div class="gst-card gst-sc-results-card">
    <div class="gst-sc-results-header">
        <span id="sc-meta" class="gst-muted">@Loc.GetString("/graphsearchtools/tools/searchconsole/idle")</span>
        <button type="button" id="sc-show-query" class="gst-btn gst-btn--sm" hidden>@Loc.GetString("/graphsearchtools/tools/searchconsole/show_query")</button>
    </div>
    <pre id="sc-query-text" class="gst-sc-query-text" hidden></pre>
    <table class="gst-table gst-sc-table">
        <thead>
        <tr>
            <th class="gst-sc-col-rank">#</th>
            <th>@Loc.GetString("/graphsearchtools/tools/searchconsole/col_name")</th>
            <th class="gst-sc-col-type">@Loc.GetString("/graphsearchtools/tools/searchconsole/col_type")</th>
            <th class="gst-sc-col-lang">@Loc.GetString("/graphsearchtools/tools/searchconsole/col_lang")</th>
            <th class="gst-sc-col-score">@Loc.GetString("/graphsearchtools/tools/searchconsole/col_score")</th>
            <th>@Loc.GetString("/graphsearchtools/tools/searchconsole/col_snippet")</th>
        </tr>
        </thead>
        <tbody id="sc-grid"></tbody>
    </table>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/searchconsole.js")"></script>
}
