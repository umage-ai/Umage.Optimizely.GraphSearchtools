@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/savedqueries/title");
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/tools/savedqueries/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/tools/savedqueries/description")</p>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

<div class="gst-card">
    <div class="gst-toolbar">
        <input id="sq-filter" type="text" placeholder="@Loc.GetString("/graphsearchtools/tools/savedqueries/filter_placeholder")" />
        <div class="gst-toolbar__spacer"></div>
        <button type="button" id="sq-add" class="gst-btn gst-btn--primary">+ @Loc.GetString("/graphsearchtools/tools/savedqueries/add")</button>
    </div>
    <table class="gst-table gst-sq-table">
        <thead>
        <tr>
            <th>@Loc.GetString("/graphsearchtools/tools/savedqueries/col_name")</th>
            <th>@Loc.GetString("/graphsearchtools/tools/savedqueries/col_query")</th>
            <th class="gst-sq-col-ranking">@Loc.GetString("/graphsearchtools/tools/savedqueries/col_ranking")</th>
            <th class="gst-sq-col-locale">@Loc.GetString("/graphsearchtools/tools/savedqueries/col_locale")</th>
            <th class="gst-sq-col-actions"></th>
        </tr>
        </thead>
        <tbody id="sq-grid"></tbody>
    </table>
</div>

<div id="sq-dialog" class="gst-dialog-backdrop" hidden>
    <div class="gst-dialog">
        <div class="gst-dialog__header">
            <h2 id="sq-dialog-title" class="gst-dialog__title">@Loc.GetString("/graphsearchtools/tools/savedqueries/edit_title")</h2>
            <button type="button" id="sq-dialog-close" class="gst-dialog__close">&times;</button>
        </div>
        <div class="gst-dialog__body">
            <div class="gst-sq-field">
                <label>@Loc.GetString("/graphsearchtools/tools/savedqueries/field_name") *</label>
                <input id="sq-name" type="text" />
            </div>
            <div class="gst-sq-field">
                <label>@Loc.GetString("/graphsearchtools/tools/savedqueries/field_description")</label>
                <input id="sq-description" type="text" />
            </div>
            <div class="gst-sq-field">
                <label>@Loc.GetString("/graphsearchtools/tools/savedqueries/field_query") *</label>
                <input id="sq-query" type="text" />
            </div>
            <div class="gst-sq-row">
                <div class="gst-sq-field">
                    <label>@Loc.GetString("/graphsearchtools/tools/savedqueries/field_locale")</label>
                    <select id="sq-locale"></select>
                </div>
                <div class="gst-sq-field">
                    <label>@Loc.GetString("/graphsearchtools/tools/savedqueries/field_ranking")</label>
                    <select id="sq-ranking">
                        <option value="RELEVANCE">RELEVANCE</option>
                        <option value="SEMANTIC">SEMANTIC</option>
                        <option value="BOOST_ONLY">BOOST_ONLY</option>
                        <option value="DOC">DOC</option>
                    </select>
                </div>
            </div>
            <div class="gst-sq-row">
                <div class="gst-sq-field">
                    <label>@Loc.GetString("/graphsearchtools/tools/savedqueries/field_weight")</label>
                    <input id="sq-weight" type="number" step="0.05" min="-1" max="1" value="0.2" />
                </div>
                <div class="gst-sq-field">
                    <label>@Loc.GetString("/graphsearchtools/tools/savedqueries/field_min_score")</label>
                    <input id="sq-min-score" type="number" step="0.1" placeholder="—" />
                </div>
                <div class="gst-sq-field">
                    <label>@Loc.GetString("/graphsearchtools/tools/savedqueries/field_limit")</label>
                    <input id="sq-limit" type="number" min="1" max="100" value="25" />
                </div>
            </div>
        </div>
        <div class="gst-dialog__footer">
            <button type="button" id="sq-dialog-cancel" class="gst-btn">@Loc.GetString("/graphsearchtools/ui/shared/cancel")</button>
            <button type="button" id="sq-dialog-save" class="gst-btn gst-btn--primary">@Loc.GetString("/graphsearchtools/ui/shared/save")</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/savedqueries.js")"></script>
}
