@using EPiServer.Shell
@using UmageAI.Optimizely.GraphSearchTools.Tools.SavedQueries
@inject LocalizationService Loc
@inject QueryRunnerService Runner
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/savedqueries/title");
    var defaultQueryActive = Runner.IsDefaultQueryActive;
    var knobDisabled = defaultQueryActive ? "disabled" : null;
    // Phase 2.5 §4.3 — embed mode renders inside the Profiles detail Try-it
    // iframe; pick up the profile key so the runner can constrain locale and
    // pre-fetch the GraphQL document via the profile API.
    var isEmbed = string.Equals(Context.Request.Query["embed"].ToString(), "1", StringComparison.Ordinal);
    var profileKey = Context.Request.Query["profileKey"].ToString();
}

@if (!isEmbed)
{
    <div class="gst-page-header">
        <h1>@Loc.GetString("/graphsearchtools/tools/savedqueries/title")</h1>
        <p>@Loc.GetString("/graphsearchtools/tools/savedqueries/description")</p>
    </div>
}

<div id="gst-alert" class="gst-alert" hidden></div>

@if (defaultQueryActive)
{
    <div class="gst-alert gst-alert--info gst-sq-default-query-notice">
        @Loc.GetString("/graphsearchtools/tools/savedqueries/default_query_active")
    </div>
}

<div class="gst-sq-layout">
    @* ───────── Left rail: presets ───────── *@
    <aside class="gst-card gst-sq-rail">
        <div class="gst-sq-rail__head">
            <span class="gst-sq-rail__title">@Loc.GetString("/graphsearchtools/tools/savedqueries/presets_title")</span>
            <button type="button" id="sq-add" class="gst-btn gst-btn--sm gst-btn--primary">@Loc.GetString("/graphsearchtools/tools/savedqueries/presets_add")</button>
        </div>
        <input id="sq-filter" type="text" class="gst-sq-rail__filter"
               placeholder="@Loc.GetString("/graphsearchtools/tools/savedqueries/presets_filter_placeholder")" />
        <div id="sq-presets" class="gst-sq-rail__list" aria-live="polite"></div>
    </aside>

    @* ───────── Main column: runner + results ───────── *@
    <section class="gst-sq-main">
        <div class="gst-card gst-sq-runner">
            <div class="gst-sq-runner__row">
                <input id="sq-query" type="text" class="gst-sq-query"
                       placeholder="@Loc.GetString("/graphsearchtools/tools/savedqueries/placeholder")"
                       autocomplete="off" />
                <select id="sq-locale" class="gst-select"></select>
                <button type="button" id="sq-run" class="gst-btn gst-btn--primary">@Loc.GetString("/graphsearchtools/tools/savedqueries/run")</button>
                <button type="button" id="sq-save" class="gst-btn">@Loc.GetString("/graphsearchtools/tools/savedqueries/save")</button>
            </div>

            <div class="gst-sq-knobs@(defaultQueryActive ? " gst-sq-knobs--locked" : null)">
                <label class="gst-sq-knob">
                    <span>@Loc.GetString("/graphsearchtools/tools/savedqueries/ranking")</span>
                    <select id="sq-ranking" class="gst-select" disabled="@knobDisabled">
                        <option value="RELEVANCE">RELEVANCE</option>
                        <option value="SEMANTIC">SEMANTIC</option>
                        <option value="BOOST_ONLY">BOOST_ONLY</option>
                        <option value="DOC">DOC</option>
                    </select>
                </label>
                <label class="gst-sq-knob">
                    <span>@Loc.GetString("/graphsearchtools/tools/savedqueries/semantic_weight") <output id="sq-weight-out">0.2</output></span>
                    <input id="sq-weight" type="range" min="-1" max="1" step="0.05" value="0.2" disabled="@knobDisabled" />
                </label>
                <label class="gst-sq-knob">
                    <span>@Loc.GetString("/graphsearchtools/tools/savedqueries/min_score")</span>
                    <input id="sq-min-score" type="number" step="0.1" placeholder="—" disabled="@knobDisabled" />
                </label>
                <label class="gst-sq-knob">
                    <span>@Loc.GetString("/graphsearchtools/tools/savedqueries/limit")</span>
                    <input id="sq-limit" type="number" min="1" max="100" value="25" />
                </label>
            </div>
        </div>

        <div class="gst-card gst-sq-results">
            <div class="gst-sq-results__head">
                <span id="sq-meta" class="gst-muted">@Loc.GetString("/graphsearchtools/tools/savedqueries/idle")</span>
                <button type="button" id="sq-show-query" class="gst-btn gst-btn--sm" hidden>@Loc.GetString("/graphsearchtools/tools/savedqueries/show_query")</button>
            </div>
            <pre id="sq-query-text" class="gst-sq-query-text" hidden></pre>
            <table class="gst-table gst-sq-results__table">
                <thead>
                <tr>
                    <th class="gst-sq-col-rank">#</th>
                    <th>@Loc.GetString("/graphsearchtools/tools/savedqueries/col_name")</th>
                    <th class="gst-sq-col-type">@Loc.GetString("/graphsearchtools/tools/savedqueries/col_type")</th>
                    <th class="gst-sq-col-lang">@Loc.GetString("/graphsearchtools/tools/savedqueries/col_lang")</th>
                    <th class="gst-sq-col-score">@Loc.GetString("/graphsearchtools/tools/savedqueries/col_score")</th>
                    <th>@Loc.GetString("/graphsearchtools/tools/savedqueries/col_snippet")</th>
                </tr>
                </thead>
                <tbody id="sq-grid"></tbody>
            </table>
        </div>
    </section>
</div>

@* ───────── Save dialog ───────── *@
<div id="sq-dialog" class="gst-dialog-backdrop" hidden>
    <div class="gst-dialog">
        <div class="gst-dialog__header">
            <h2 id="sq-dialog-title" class="gst-dialog__title">@Loc.GetString("/graphsearchtools/tools/savedqueries/new_title")</h2>
            <button type="button" id="sq-dialog-close" class="gst-dialog__close">&times;</button>
        </div>
        <div class="gst-dialog__body">
            <div class="gst-sq-field">
                <label>@Loc.GetString("/graphsearchtools/tools/savedqueries/field_name") *</label>
                <input id="sq-dlg-name" type="text" />
            </div>
            <div class="gst-sq-field">
                <label>@Loc.GetString("/graphsearchtools/tools/savedqueries/field_description")</label>
                <input id="sq-dlg-description" type="text" />
            </div>
        </div>
        <div class="gst-dialog__footer">
            <button type="button" id="sq-dialog-cancel" class="gst-btn">@Loc.GetString("/graphsearchtools/ui/shared/cancel")</button>
            <button type="button" id="sq-dialog-save" class="gst-btn gst-btn--primary">@Loc.GetString("/graphsearchtools/ui/shared/save")</button>
        </div>
    </div>
</div>

@section Scripts {
    @if (isEmbed)
    {
        <script>
            window.GST_DIAGNOSTICS_EMBED = {
                profileKey: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(profileKey))
            };
        </script>
    }
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/savedqueries.js")"></script>
}
