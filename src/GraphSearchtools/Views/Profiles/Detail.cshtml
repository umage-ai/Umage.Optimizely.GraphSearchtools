@using EPiServer.Shell
@using UmageAI.Optimizely.GraphSearchTools.Tools.Profiles.Models
@model UmageAI.Optimizely.GraphSearchTools.Tools.Profiles.Models.ProfileDetailViewModel
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Model.DisplayName;
    var docExistsClass = Model.GraphQLDocExists ? "gst-mono" : "gst-mono gst-prof-meta__missing";
}

<div class="gst-page-header">
    <div class="gst-page-header__title">
        <h1>@Model.DisplayName</h1>
        @if (!string.IsNullOrEmpty(Model.DescriptionResolved))
        {
            <p>@Model.DescriptionResolved</p>
        }
    </div>
    <div class="gst-flex">
        <a href="/EPiServer/cms/graphsearchtools/profiles" class="gst-btn">
            @Loc.GetString("/graphsearchtools/profiles/detail/backToList")
        </a>
    </div>
</div>

<div id="gst-prof-detail-alert" class="gst-alert" hidden></div>

<div class="gst-prof-layout" data-profile-key="@Model.Key">
    @* ───────── Left rail: profile metadata ───────── *@
    <aside class="gst-prof-rail">
        <div class="gst-card">
            <div class="gst-card__body">
                <h2>@Model.DisplayName</h2>
                <div class="gst-prof-name__key">@Model.Key</div>

                <dl class="gst-prof-meta">
                    <div>
                        <dt>@Loc.GetString("/graphsearchtools/profiles/detail/meta/sites")</dt>
                        <dd>
                            @if (Model.Sites.Count == 0)
                            {
                                <span class="gst-badge gst-badge--default">
                                    @Loc.GetString("/graphsearchtools/profiles/detail/meta/allSites")
                                </span>
                            }
                            else
                            {
                                <div class="gst-flex" style="gap: 4px; flex-wrap: wrap">
                                    @foreach (var site in Model.Sites)
                                    {
                                        <span class="gst-badge gst-badge--default">@site</span>
                                    }
                                </div>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>@Loc.GetString("/graphsearchtools/profiles/detail/meta/locales")</dt>
                        <dd>
                            @if (Model.Locales.Count == 0)
                            {
                                <span class="gst-badge gst-badge--default">
                                    @Loc.GetString("/graphsearchtools/profiles/detail/meta/allLocales")
                                </span>
                            }
                            else
                            {
                                <div class="gst-flex" style="gap: 4px; flex-wrap: wrap">
                                    @foreach (var loc in Model.Locales)
                                    {
                                        <span class="gst-badge gst-badge--primary">@loc</span>
                                    }
                                </div>
                            }
                        </dd>
                    </div>
                    @if (Model.SearchedFields.Count > 0)
                    {
                        <div>
                            <dt>@Loc.GetString("/graphsearchtools/profiles/detail/meta/searchedFields")</dt>
                            <dd>
                                <div class="gst-flex" style="gap: 4px; flex-wrap: wrap">
                                    @foreach (var field in Model.SearchedFields)
                                    {
                                        <span class="gst-badge gst-badge--default">@field</span>
                                    }
                                </div>
                            </dd>
                        </div>
                    }
                    <div>
                        <dt>@Loc.GetString("/graphsearchtools/profiles/detail/meta/synonymSlot")</dt>
                        <dd>
                            @if (string.IsNullOrEmpty(Model.SynonymSlot))
                            {
                                <span class="gst-muted">—</span>
                            }
                            else
                            {
                                <span class="gst-mono">"@Model.SynonymSlot"</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>@Loc.GetString("/graphsearchtools/profiles/detail/meta/pinnedKey")</dt>
                        <dd>
                            @if (string.IsNullOrEmpty(Model.PinnedKeyFormula))
                            {
                                <span class="gst-muted">—</span>
                            }
                            else
                            {
                                <span class="gst-mono">@Model.PinnedKeyFormula</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>@Loc.GetString("/graphsearchtools/profiles/detail/meta/ranking")</dt>
                        <dd>
                            @Model.RankingName.ToUpperInvariant() · @Model.SemanticWeight.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
                        </dd>
                    </div>
                    <div>
                        <dt>@Loc.GetString("/graphsearchtools/profiles/detail/meta/graphqlDoc")</dt>
                        <dd>
                            @if (string.IsNullOrEmpty(Model.GraphQLDocPath))
                            {
                                <span class="gst-muted">—</span>
                            }
                            else
                            {
                                <span class="@docExistsClass">@Model.GraphQLDocPath</span>
                                @if (!Model.GraphQLDocExists)
                                {
                                    <span class="em">@Loc.GetString("/graphsearchtools/profiles/detail/meta/docNotFound")</span>
                                }
                            }
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        @if (Model.IsSiteShared)
        {
            <div class="gst-alert gst-alert--warning" style="margin-top: var(--gst-space-md)">
                @Loc.GetString("/graphsearchtools/profiles/detail/sharedWarning")
            </div>
        }
    </aside>

    @* ───────── Main column: tabs + editor ───────── *@
    <section>
        <div class="gst-card">
            <div class="gst-tabs gst-prof-tabs">
                <button type="button" class="gst-tab active" data-tab="overview">
                    @Loc.GetString("/graphsearchtools/profiles/detail/tabs/overview")
                </button>
                <button type="button" class="gst-tab" data-tab="pinned">
                    @Loc.GetString("/graphsearchtools/profiles/detail/tabs/pinned")
                </button>
                @if (Model.HasSynonymTab)
                {
                    <button type="button" class="gst-tab" data-tab="synonyms">
                        @Loc.GetString("/graphsearchtools/profiles/detail/tabs/synonyms")
                    </button>
                }
                <button type="button" class="gst-tab" data-tab="tryit">
                    @Loc.GetString("/graphsearchtools/profiles/detail/tabs/tryProd")
                </button>
                <button type="button" class="gst-tab" data-tab="audit">
                    @Loc.GetString("/graphsearchtools/profiles/detail/tabs/audit")
                    <span id="gst-prof-audit-badge" class="gst-badge gst-badge--default" hidden>0</span>
                </button>
            </div>

            <div class="gst-tab-pane" data-pane="overview">
                <div class="gst-card__body">
                    <p class="gst-muted">@Loc.GetString("/graphsearchtools/profiles/detail/comingSoon")</p>
                </div>
            </div>

            @* Phase 2.5 §4.1 — Pinned tab editor. Site & locale pickers are
               constrained to the profile's declared scope; the resolved Graph
               collection key is shown read-only below the controls. The right
               rail Try-it side panel runs the registered GraphQL document for
               this profile. JS hydrates everything via /api/profiles/{key}/pinned. *@
            <div class="gst-tab-pane" data-pane="pinned" hidden>
                <div id="gst-pin-tab-alert" class="gst-alert" hidden></div>

                <div class="gst-card__body">
                    <div class="gst-pin-controls">
                        <div class="gst-field">
                            <label for="gst-pin-site">@Loc.GetString("/graphsearchtools/profiles/detail/meta/sites")</label>
                            <select id="gst-pin-site" class="gst-select"
                                    @(Model.IsSiteShared || Model.Sites.Count <= 1 ? "disabled" : "")>
                                @if (Model.IsSiteShared)
                                {
                                    <option value="">@Loc.GetString("/graphsearchtools/profiles/detail/pinned/sharedSite")</option>
                                }
                                else if (Model.Sites.Count == 0)
                                {
                                    <option value="">@Loc.GetString("/graphsearchtools/profiles/detail/meta/allSites")</option>
                                }
                                else
                                {
                                    @foreach (var site in Model.Sites)
                                    {
                                        <option value="@site">@site</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="gst-field">
                            <label for="gst-pin-locale">@Loc.GetString("/graphsearchtools/profiles/detail/meta/locales")</label>
                            <select id="gst-pin-locale" class="gst-select"
                                    @(Model.Locales.Count == 0 ? "disabled" : "")>
                                @if (Model.Locales.Count == 0)
                                {
                                    <option value="">@Loc.GetString("/graphsearchtools/profiles/detail/meta/allLocales")</option>
                                }
                                else
                                {
                                    @foreach (var loc in Model.Locales)
                                    {
                                        <option value="@loc">@loc</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="gst-field" style="margin-left: auto">
                            <label>&nbsp;</label>
                            <button type="button" id="gst-pin-add" class="gst-btn gst-btn--primary">
                                + @Loc.GetString("/graphsearchtools/tools/pinned/add")
                            </button>
                        </div>
                    </div>

                    <div class="gst-pin-keyline">
                        <span class="gst-pin-keyline__label">@Loc.GetString("/graphsearchtools/profiles/detail/pinned/keyLabel")</span>
                        <span class="gst-pin-keyline__value gst-mono" id="gst-pin-keyline-value">—</span>
                        @if (!string.IsNullOrEmpty(Model.GraphQLDocPath))
                        {
                            <span class="gst-pin-keyline__hint">
                                <code class="gst-mono">@Model.GraphQLDocPath</code>
                            </span>
                        }
                    </div>
                </div>

                <div class="gst-pin-with-tryit" style="padding: 0 var(--gst-space-lg) var(--gst-space-lg)">
                    @* Pin board: phrases at top, pinned items below, organic results under a divider *@
                    <div>
                        <div class="gst-card" style="margin: 0">
                            <div class="gst-pin-phrases" id="gst-pin-phrases"></div>

                            <div class="gst-pin-board__head">
                                <h3 id="gst-pin-board-title">@Loc.GetString("/graphsearchtools/profiles/detail/pinned/empty")</h3>
                            </div>

                            <table class="gst-table gst-pin-table">
                                <thead>
                                    <tr>
                                        <th class="col-rank">#</th>
                                        <th>@Loc.GetString("/graphsearchtools/tools/pinned/col_content")</th>
                                        <th class="col-actions"></th>
                                    </tr>
                                </thead>
                                <tbody id="gst-pin-rows"></tbody>
                                <tbody id="gst-pin-organic-rows">
                                    <tr class="gst-pin-divider" hidden>
                                        <td colspan="3">@Loc.GetString("/graphsearchtools/profiles/detail/pinned/organicTitle")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* Try-it side panel — minimal live preview. The richer Try-in-production-query
                       tab (owned by the Diagnostics agent) lives separately. *@
                    <aside class="gst-card" style="margin: 0; align-self: start;">
                        <div class="gst-card__header">
                            <span class="gst-card__title">@Loc.GetString("/graphsearchtools/profiles/detail/pinned/tryTitle")</span>
                        </div>
                        <div class="gst-card__body">
                            @if (string.IsNullOrEmpty(Model.GraphQLDocPath))
                            {
                                <p class="gst-muted" style="font-size: var(--gst-text-sm)">
                                    @Loc.GetString("/graphsearchtools/profiles/detail/pinned/tryDisabled")
                                </p>
                            }
                            else
                            {
                                <div id="gst-pin-tryit">
                                    <div class="gst-tryit__input">
                                        <span>Q</span>
                                        <input id="gst-pin-tryit-q" type="text" placeholder="Try a phrase…" />
                                    </div>
                                    <div class="gst-tryit__compare">
                                        <div class="gst-tryit__col a">
                                            <h4>Without pins</h4>
                                            <ol id="gst-pin-tryit-a"></ol>
                                        </div>
                                        <div class="gst-tryit__col b">
                                            <h4>With pins</h4>
                                            <ol id="gst-pin-tryit-b"></ol>
                                        </div>
                                    </div>
                                    <div class="gst-tryit__footer">
                                        <span id="gst-pin-tryit-stats"></span>
                                    </div>
                                </div>
                                <!-- TODO: hand-off to Diagnostics agent — richer Try-it (raw response,
                                     score / fulltext debug projections) lives in the "Try in production
                                     query" tab; the side panel here is intentionally minimal. -->
                            }
                        </div>
                    </aside>
                </div>
            </div>

            @if (Model.HasSynonymTab)
            {
                <div class="gst-tab-pane" data-pane="synonyms" hidden>
                    <div class="gst-card__body">
                        <div id="gst-prof-synonyms-host"
                             data-profile-key="@Model.Key"
                             data-locales="@string.Join(",", Model.Locales)">
                        </div>
                    </div>
                </div>
            }

            @* Phase 2.5 §4.3 — per-profile Try-it tab. Embeds the Saved Queries /
               Diagnostics runner as an iframe scoped to this profile. The full
               in-tab editor (variables, raw response, score / fulltext debug)
               lands once the runner exposes a `GST.diagnostics.runner({...})`
               factory; the iframe is the v0.2.5 path. *@
            <div class="gst-tab-pane" data-pane="tryit" hidden>
                <div class="gst-card__body">
                    @if (string.IsNullOrEmpty(Model.GraphQLDocPath))
                    {
                        <div class="gst-prof-tryit-empty">
                            <h3>@Loc.GetString("/graphsearchtools/profiles/detail/tryProd/title")</h3>
                            <p class="gst-muted">@Loc.GetString("/graphsearchtools/profiles/detail/tryProd/noDocument")</p>
                        </div>
                    }
                    else
                    {
                        var savedQueriesUrl = Paths.ToResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider),
                            "GraphSearchtools/SavedQueries");
                        var iframeSrc = $"{savedQueriesUrl}?embed=1&profileKey={Uri.EscapeDataString(Model.Key)}";
                        <div class="gst-prof-tryit">
                            <iframe id="gst-prof-tryit-frame"
                                    class="gst-prof-tryit__frame"
                                    src="@iframeSrc"
                                    title="@Loc.GetString("/graphsearchtools/profiles/detail/tryProd/title")"
                                    loading="lazy"></iframe>
                        </div>
                    }
                </div>
            </div>

            <div class="gst-tab-pane" data-pane="audit" hidden>
                <div class="gst-card__body">
                    <div id="gst-prof-audit-host">
                        <p class="gst-muted">@Loc.GetString("/graphsearchtools/ui/shared/loading")</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/synonyms.js")"></script>
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/pinned.js")"></script>
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/profiles.js")"></script>
    <script>
        (function() {
            if (window.GST && window.GST.profiles && typeof window.GST.profiles.detail === 'function') {
                window.GST.profiles.detail({
                    profileKey: '@Html.Raw(Model.Key)',
                    sites: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Sites)),
                    locales: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Locales)),
                    isGeneric: @(Model.IsGeneric ? "true" : "false"),
                    isSiteShared: @(Model.IsSiteShared ? "true" : "false"),
                    pinnedKeyFormula: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PinnedKeyFormula)),
                    hasGraphQLDoc: @(Model.GraphQLDocExists ? "true" : "false")
                });
            }
        })();
    </script>
}
