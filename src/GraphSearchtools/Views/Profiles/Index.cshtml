@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/profiles/index/title");
}

<div class="gst-page-header">
    <div class="gst-page-header__title">
        <h1>@Loc.GetString("/graphsearchtools/profiles/index/title")</h1>
        <p>@Loc.GetString("/graphsearchtools/profiles/index/subtitle")</p>
    </div>
</div>

<div id="gst-prof-alert" class="gst-alert" hidden></div>

@* ───────── Stats row ───────── *@
<div class="gst-stats" id="gst-prof-stats">
    <div class="gst-stat">
        <div class="gst-stat__value" id="gst-prof-stat-count">—</div>
        <div class="gst-stat__label">@Loc.GetString("/graphsearchtools/profiles/index/stats/profiles")</div>
        <div class="gst-stat__sub" id="gst-prof-stat-count-sub">&nbsp;</div>
    </div>
    <div class="gst-stat">
        <div class="gst-stat__value" id="gst-prof-stat-pinned">—</div>
        <div class="gst-stat__label">@Loc.GetString("/graphsearchtools/profiles/index/stats/pinned")</div>
        <div class="gst-stat__sub" id="gst-prof-stat-pinned-sub">&nbsp;</div>
    </div>
    <div class="gst-stat">
        <div class="gst-stat__value" id="gst-prof-stat-synonyms">—</div>
        <div class="gst-stat__label">@Loc.GetString("/graphsearchtools/profiles/index/stats/synonyms")</div>
        <div class="gst-stat__sub" id="gst-prof-stat-synonyms-sub">&nbsp;</div>
    </div>
    <div class="gst-stat">
        <div class="gst-stat__value">—</div>
        <div class="gst-stat__label">@Loc.GetString("/graphsearchtools/profiles/index/stats/coverage")</div>
        <div class="gst-stat__sub">&nbsp;</div>
    </div>
</div>

@* ───────── Profile index card ───────── *@
<div class="gst-card">
    <div class="gst-toolbar">
        <div class="gst-search">
            <svg class="gst-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="gst-prof-search"
                   placeholder="@Loc.GetString("/graphsearchtools/profiles/index/filterPlaceholder")" />
        </div>
        <select id="gst-prof-site-filter" class="gst-select">
            <option value="">@Loc.GetString("/graphsearchtools/profiles/index/filter/allSites")</option>
        </select>
        <select id="gst-prof-locale-filter" class="gst-select">
            <option value="">@Loc.GetString("/graphsearchtools/profiles/index/filter/allLocales")</option>
        </select>
        <div class="gst-toolbar__spacer"></div>
        <span id="gst-prof-count" class="gst-muted">&nbsp;</span>
    </div>

    <div id="gst-prof-table-host"></div>

    <div id="gst-prof-empty" class="gst-empty" hidden>
        <h3>@Loc.GetString("/graphsearchtools/profiles/index/empty/title")</h3>
        <p>@Loc.GetString("/graphsearchtools/profiles/index/empty/body")</p>
    </div>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/profiles.js")"></script>
    <script>
        (function() {
            if (window.GST && window.GST.profiles && typeof window.GST.profiles.index === 'function') {
                window.GST.profiles.index({
                    detailUrlBase: '/EPiServer/cms/graphsearchtools/profiles/'
                });
            }
        })();
    </script>
}
