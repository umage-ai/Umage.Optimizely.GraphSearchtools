@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/synonyms/title");
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/tools/synonyms/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/tools/synonyms/description")</p>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

@* Aurora Rules grid. The former "Unused" tab was rolled into the Activity
   (30d) column + an Activity filter — same data, surfaced inline instead
   of behind a tab switch so marketers see used-vs-unused at a glance. *@
<div class="gst-toolbar">
    <div class="gst-search">
        <svg class="gst-search__icon" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="gst-syn-search"
               placeholder="@Loc.GetString("/graphsearchtools/ui/synonyms/filter_placeholder")" />
    </div>
    <label class="gst-filter">
        <span class="gst-filter__label">@Loc.GetString("/graphsearchtools/profiles/detail/synonyms/colScope")</span>
        <select class="gst-filter__select" id="gst-syn-locale-filter">
            <option value="">@Loc.GetString("/graphsearchtools/ui/shared/all")</option>
        </select>
    </label>
    <div class="gst-toolbar__spacer"></div>
    <button type="button" id="gst-syn-create" class="gst-btn gst-btn--primary">
        + @Loc.GetString("/graphsearchtools/profiles/detail/synonyms/addRow")
    </button>
</div>

<table class="gst-table gst-syn-aurora-table">
    <thead>
        <tr>
            <th data-sort="rule">@Loc.GetString("/graphsearchtools/ui/synonyms/col_rule")</th>
            <th data-sort="locale">@Loc.GetString("/graphsearchtools/profiles/detail/synonyms/colScope")</th>
            <th data-sort="activity">@Loc.GetString("/graphsearchtools/ui/synonyms/col_activity")</th>
            <th aria-label="Actions"></th>
        </tr>
    </thead>
    <tbody id="gst-syn-aurora-rows"></tbody>
</table>

@* Synonym flyout — shared markup; the Aurora JS opens/closes it via GST.flyout.
   Use the absolute path so Razor's partial search doesn't spurious-404 against
   a separate `.Views` assembly that this RCL doesn't emit. *@
@await Html.PartialAsync("/Views/Shared/_SynonymFlyout.cshtml")

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/synonyms-aurora.js")"></script>
}
