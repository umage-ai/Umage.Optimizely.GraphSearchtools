@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/searchLogs/title");
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/tools/searchLogs/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/tools/searchLogs/description")</p>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

<div class="gst-card gst-sl-toolbar-card">
    <div class="gst-toolbar gst-sl-toolbar">
        <div class="gst-sl-pillgroup" role="group" aria-label="Time window">
            <button type="button" class="gst-sl-pill" data-window="1h">@Loc.GetString("/graphsearchtools/tools/searchLogs/window_1h")</button>
            <button type="button" class="gst-sl-pill gst-sl-pill--active" data-window="24h">@Loc.GetString("/graphsearchtools/tools/searchLogs/window_24h")</button>
            <button type="button" class="gst-sl-pill" data-window="7d">@Loc.GetString("/graphsearchtools/tools/searchLogs/window_7d")</button>
            <button type="button" class="gst-sl-pill" data-window="30d">@Loc.GetString("/graphsearchtools/tools/searchLogs/window_30d")</button>
        </div>
        <div class="gst-toolbar__spacer"></div>
        <button type="button" id="sl-refresh" class="gst-btn">
            @Loc.GetString("/graphsearchtools/ui/shared/refresh")
        </button>
    </div>
</div>

<div id="sl-empty" class="gst-card gst-sl-empty" hidden>
    <h2>@Loc.GetString("/graphsearchtools/tools/searchLogs/empty_title")</h2>
    <p>@Loc.GetString("/graphsearchtools/tools/searchLogs/empty_body")</p>
</div>

<div class="gst-sl-grid">
    @* ───────── Top phrases ───────── *@
    <div class="gst-card gst-sl-card" data-card="top">
        <div class="gst-sl-card__head">
            <h2>@Loc.GetString("/graphsearchtools/tools/searchLogs/top_title")</h2>
        </div>
        <table class="gst-table gst-sl-table">
            <thead>
                <tr>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_phrase")</th>
                    <th class="num">@Loc.GetString("/graphsearchtools/tools/searchLogs/col_count")</th>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_locale")</th>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_profile")</th>
                </tr>
            </thead>
            <tbody id="sl-top"></tbody>
        </table>
    </div>

    @* ───────── Zero-result phrases ───────── *@
    <div class="gst-card gst-sl-card" data-card="zero">
        <div class="gst-sl-card__head">
            <h2>@Loc.GetString("/graphsearchtools/tools/searchLogs/zero_results_title")</h2>
        </div>
        <table class="gst-table gst-sl-table">
            <thead>
                <tr>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_phrase")</th>
                    <th class="num">@Loc.GetString("/graphsearchtools/tools/searchLogs/col_count")</th>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_locale")</th>
                    <th class="gst-sl-action-col"></th>
                </tr>
            </thead>
            <tbody id="sl-zero"></tbody>
        </table>
    </div>

    @* ───────── Low-CTR phrases ───────── *@
    <div class="gst-card gst-sl-card" data-card="lowctr">
        <div class="gst-sl-card__head">
            <h2>@Loc.GetString("/graphsearchtools/tools/searchLogs/low_ctr_title")</h2>
        </div>
        <table class="gst-table gst-sl-table">
            <thead>
                <tr>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_phrase")</th>
                    <th class="num">@Loc.GetString("/graphsearchtools/tools/searchLogs/col_count")</th>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_profile")</th>
                    <th class="gst-sl-action-col"></th>
                </tr>
            </thead>
            <tbody id="sl-lowctr"></tbody>
        </table>
    </div>

    @* ───────── Recent raw events (live tail) ───────── *@
    <div class="gst-card gst-sl-card gst-sl-card--wide" data-card="raw">
        <div class="gst-sl-card__head">
            <h2>@Loc.GetString("/graphsearchtools/tools/searchLogs/raw_title")</h2>
        </div>
        <table class="gst-table gst-sl-table gst-sl-table--raw">
            <thead>
                <tr>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_when")</th>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_phrase")</th>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_locale")</th>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_profile")</th>
                    <th class="num">@Loc.GetString("/graphsearchtools/tools/searchLogs/col_top_result")</th>
                    <th class="num">@Loc.GetString("/graphsearchtools/tools/searchLogs/col_duration")</th>
                    <th>@Loc.GetString("/graphsearchtools/tools/searchLogs/col_status")</th>
                </tr>
            </thead>
            <tbody id="sl-raw"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/search-logs.js")"></script>
}
