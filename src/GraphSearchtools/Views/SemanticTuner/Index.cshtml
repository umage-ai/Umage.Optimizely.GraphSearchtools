@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/semanticTuner/title");
}

<div class="gst-page-header">
    <h1>@Loc.GetString("/graphsearchtools/tools/semanticTuner/title")</h1>
    <p>@Loc.GetString("/graphsearchtools/tools/semanticTuner/description")</p>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

<div class="gst-card gst-stuner-card">
    <div class="gst-card__body">
        <div class="gst-stuner-tiers" data-st="tiers" aria-live="polite">
            @* tier rows are rendered by JS *@
        </div>

        <div class="gst-stuner-actions">
            <button type="button" class="gst-btn gst-btn--sm" data-st="add">
                @Loc.GetString("/graphsearchtools/tools/semanticTuner/add_tier")
            </button>
            <div class="gst-stuner-actions__spacer"></div>
            <button type="button" class="gst-btn gst-btn--primary" data-st="save">
                @Loc.GetString("/graphsearchtools/tools/semanticTuner/save")
            </button>
        </div>
    </div>
</div>

<div class="gst-card gst-stuner-card">
    <div class="gst-card__header">
        <span class="gst-card__title">@Loc.GetString("/graphsearchtools/tools/semanticTuner/snippet_label")</span>
    </div>
    <div class="gst-card__body">
        <p class="gst-stuner-help">@Loc.GetString("/graphsearchtools/tools/semanticTuner/snippet_help")</p>
        <pre class="gst-mono gst-stuner-snippet" data-st="snippet"></pre>
        <button type="button" class="gst-btn gst-btn--sm" data-st="copy">
            @Loc.GetString("/graphsearchtools/tools/semanticTuner/copy")
        </button>
    </div>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/semantic-tuner.js")"></script>
    <script>
        (function () {
            GST.semanticTuner.boot({ container: document.body });
        })();
    </script>
}
