@using EPiServer.Shell
@inject LocalizationService Loc
@{
    Layout = "/Views/Shared/_SearchtoolsLayout.cshtml";
    ViewData["Title"] = Loc.GetString("/graphsearchtools/tools/autocomplete/title");
}

<div class="gst-page-header">
    <div class="gst-page-header__title">
        <h1>@Loc.GetString("/graphsearchtools/tools/autocomplete/title")</h1>
        <p>@Loc.GetString("/graphsearchtools/tools/autocomplete/description")</p>
    </div>
    <a class="gst-help-icon"
       href="@Paths.ToResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "GraphSearchtools/About")"
       title="@Loc.GetString("/graphsearchtools/ui/shared/help")"
       aria-label="@Loc.GetString("/graphsearchtools/ui/shared/help")">?</a>
</div>

<div id="gst-alert" class="gst-alert" hidden></div>

<div class="gst-card">
    <div class="gst-toolbar">
        <label class="gst-ac-knob">
            <span>@Loc.GetString("/graphsearchtools/tools/autocomplete/type")</span>
            <div class="gst-combobox">
                <input id="ac-type" type="text" autocomplete="off"
                       placeholder="@Loc.GetString("/graphsearchtools/tools/autocomplete/type_placeholder")" />
            </div>
        </label>
        <label class="gst-ac-knob">
            <span>@Loc.GetString("/graphsearchtools/tools/autocomplete/field")</span>
            <div class="gst-combobox">
                <input id="ac-field" type="text" autocomplete="off"
                       placeholder="@Loc.GetString("/graphsearchtools/tools/autocomplete/field_placeholder")" />
            </div>
        </label>
        <label class="gst-ac-knob">
            <span>@Loc.GetString("/graphsearchtools/tools/autocomplete/locale_label")</span>
            <select id="ac-locale" class="gst-select"></select>
        </label>
        <label class="gst-ac-knob gst-ac-limit">
            <span>@Loc.GetString("/graphsearchtools/tools/autocomplete/limit")</span>
            <input id="ac-limit" type="number" min="1" max="25" value="10" />
        </label>
    </div>

    <div class="gst-toolbar">
        <input id="ac-input" type="text" class="gst-ac-input"
               placeholder="@Loc.GetString("/graphsearchtools/tools/autocomplete/placeholder")"
               autocomplete="off" />
        <div class="gst-toolbar__spacer"></div>
        <span id="ac-meta" class="gst-muted"></span>
    </div>

    <ul id="ac-results" class="gst-ac-results"></ul>
</div>

@section Scripts {
    <script src="@Paths.ToClientResource(typeof(UmageAI.Optimizely.GraphSearchTools.Menu.GraphSearchtoolsMenuProvider), "ClientResources/js/autocomplete.js")"></script>
}
