<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- NuGet package properties -->
    <PackageId>UmageAI.Optimizely.GraphSearchTools</PackageId>
    <Version>0.0.1-local</Version>
    <Authors>UmageAI</Authors>
    <Company>UmageAI</Company>
    <Description>Graph search tooling for Optimizely CMS — pinned results, synonyms, query playground, and relevancy tuning.</Description>
    <PackageTags>Optimizely;CMS;Graph;Search;Synonyms;PinnedResults;Relevancy;Autocomplete</PackageTags>
    <PackageProjectUrl>https://github.com/umage-ai/Umage.Optimizely.GraphSearchtools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/umage-ai/Umage.Optimizely.GraphSearchtools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Compile-time version symbols -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <DefineConstants>$(DefineConstants);OPTIMIZELY_CMS12</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);OPTIMIZELY_CMS13</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="EPiServer" />
    <Using Include="EPiServer.Core" />
    <Using Include="EPiServer.DataAbstraction" />
    <Using Include="EPiServer.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GraphSearchtools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Used by the telemetry reader's fast path (raw aggregate query against
    DDS' underlying tblBigTable). EPiServer.CMS pulls in the SqlClient
    transitively; we add an explicit reference per-TFM so the addon builds
    standalone, with a version range that matches what CMS itself
    constrains to (5.* on CMS 12, 6.* on CMS 13).
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
  </ItemGroup>

  <!--
    CMS 12 / CMS 13 packages use floating major-version ranges so the
    add-on doesn't force a specific patch level on consumers.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="EPiServer.CMS" Version="12.*" />
    <PackageReference Include="EPiServer.CMS.UI.Core" Version="12.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="EPiServer.CMS" Version="13.*" />
    <PackageReference Include="EPiServer.CMS.UI.Core" Version="13.*" />
  </ItemGroup>

  <!-- Localization language files (Optimizely XML format) -->
  <ItemGroup>
    <EmbeddedResource Include="lang\*.xml" />
  </ItemGroup>

  <!-- CMS 13 Razor layout — mapped to the same virtual path as the CMS 12 version -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Content Remove="Views\Shared\_SearchtoolsLayout.cshtml" />
    <Content Remove="Views\Shared\Cms13\_SearchtoolsLayout.cshtml" />
    <Content Include="Views\Shared\Cms13\_SearchtoolsLayout.cshtml">
      <Link>Views\Shared\_SearchtoolsLayout.cshtml</Link>
    </Content>
  </ItemGroup>

  <!-- Version-specific compile folders -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Cms13\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Cms12\**\*.cs" />
  </ItemGroup>

  <!-- Include README, icon, and BOTH .targets files in the NuGet package -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
    <None Include="build\net8.0\UmageAI.Optimizely.GraphSearchTools.targets" Pack="true" PackagePath="build\net8.0\" />
    <None Include="build\net10.0\UmageAI.Optimizely.GraphSearchTools.targets" Pack="true" PackagePath="build\net10.0\" />
  </ItemGroup>

  <!--
    Module zip: created during build, packed as contentFiles with BuildAction=None.
    The .targets file copies it to the consuming project's modules/_protected/ on first build.
  -->
  <Target Name="CreateModuleZip" BeforeTargets="Build">
    <MakeDir Directories="$(IntermediateOutputPath)module-zip" />
    <ZipDirectory SourceDirectory="modules\_protected\GraphSearchtools" DestinationFile="$(IntermediateOutputPath)module-zip\GraphSearchtools.zip" Overwrite="true" />
  </Target>

  <ItemGroup>
    <Content Include="$(IntermediateOutputPath)module-zip\GraphSearchtools.zip" Pack="true" PackagePath="contentFiles\any\any\modules\_protected\GraphSearchtools" BuildAction="None" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never">
      <Link>GraphSearchtools.zip</Link>
    </Content>
  </ItemGroup>

  <!-- Exclude the source modules/_protected folder from build output -->
  <ItemGroup>
    <Content Remove="modules\_protected\**" />
    <None Remove="modules\_protected\**" />
  </ItemGroup>

  <!-- Keep source files visible in IDE -->
  <ItemGroup>
    <None Include="modules\_protected\GraphSearchtools\**\*" />
  </ItemGroup>

</Project>
